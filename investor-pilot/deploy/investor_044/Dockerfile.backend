FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY backend/ /app/
COPY deploy/runtime-constraints.txt /tmp/constraints.txt
RUN pip install --no-cache-dir -c /tmp/constraints.txt .
COPY deploy/start_backend.py /app/start_backend.py
RUN useradd --uid 10001 --create-home petroedge && mkdir -p data dataset_store model_store prediction_store analysis_store experiment_store && chown -R petroedge:petroedge data dataset_store model_store prediction_store analysis_store experiment_store
USER 10001
EXPOSE 8000
CMD ["python","/app/start_backend.py"]
