[project]
name = "petroedge-ai-backend"
version = "0.2.0"
description = "Deployable, model-agnostic FastAPI platform for real-time well-log analytics."
requires-python = ">=3.11,<3.13"
dependencies = [
  "alembic>=1.13.0",
  "fastapi>=0.111.0",
  "joblib>=1.4.0",
  "lasio>=0.31",
  "numpy>=1.26.0,<3",
  "pandas>=2.2.0",
  "passlib[bcrypt]>=1.7.4",
  "pydantic-settings>=2.3.0",
  "python-jose[cryptography]>=3.3.0",
  "python-multipart>=0.0.9",
  "sqlalchemy>=2.0.0",
  "uvicorn[standard]>=0.30.0",
  "scikit-learn>=1.5.0",
]

[project.optional-dependencies]
tree-models = [
  "xgboost>=2.1.0",
  "lightgbm>=4.5.0",
  "catboost>=1.2.7",
]
explainability = [
  "shap>=0.46.0",
]
onnx = [
  "onnx>=1.16.0",
  "onnxruntime>=1.19.0",
  "skl2onnx>=1.17.0",
]
experiments = [
  "mlflow>=2.14.0",
]
streaming = [
  "aiokafka>=0.10.0",
  "redis>=5.0.0",
]
deep-learning = [
  "torch>=2.3.0",
  "tensorflow>=2.16.0",
]
distributed = [
  "dask[dataframe,distributed]>=2025.1.0",
  "ray[data]>=2.40.0",
  "polars>=1.20.0",
  "pyarrow>=18.0.0",
]
postgres = [
  "psycopg[binary]>=3.2.0",
]
reports = [
  "reportlab>=4.2.0",
]
dev = [
  "httpx>=0.27.0",
  "pytest>=8.2.0",
  "pytest-asyncio>=0.23.0",
  "ruff>=0.5.0",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
asyncio_mode = "auto"

[tool.ruff]
line-length = 100
target-version = "py311"